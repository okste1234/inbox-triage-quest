# Copy to .env and fill in. Never commit .env.

# Option 1 (default): Anthropic API
ANTHROPIC_API_KEY=your-key-here
MODEL=claude-opus-5-5

# Option 2: free open model through any OpenAI-compatible endpoint. Uncomment and edit.
# Local Ollama needs no key:   ollama pull llama3.1:8b
# PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL=llama3.1:8b
# Hosted free tiers (Groq, OpenRouter) also need OPENAI_API_KEY and their own base URL and model name.
# OPENAI_API_KEY=
